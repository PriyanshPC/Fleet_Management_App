@using System.Linq
@using Fleet_Management_App.Data.Entities
@model IEnumerable<Equipment>

@{
    ViewData["Title"] = "Equipment – List";

    var categoryOptions = Model
        .Select(e => e.EquipmentCategory)
        .Distinct()
        .OrderBy(c => c)
        .ToList();

    // Matches the enum values in the DB design
    var statusOptions = new[] { "All", "Available", "UnderMaintenance", "OutForRental", "Damaged" };
}

<!-- Page header: displays the equipment section title and description -->
<div class="page-head">
    <div>
        <h2 class="m-0">Equipment</h2>
        <div class="kicker">Browse and manage all assets in your fleet.</div>
    </div>
</div>

<!-- Filters card -->
<div class="card-panel mb-3">
    <form class="row g-4 align-items-end">
        <div class="col-md-2">
            <label class="form-label small-label" for="q">Search</label>
            <input id="q" class="form-control" placeholder="Search by ID, name, type…" />
        </div>
        <div class="col-md-2">
            <label class="form-label small-label" for="category">Category</label>
            <select id="category" class="form-select">
                <option>All</option>
                @foreach (var c in categoryOptions)
                {
                    <option>@c</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small-label" for="status">Availability</label>
            <select id="status" class="form-select">
                @foreach (var s in statusOptions)
                {
                    <option value="@s">@s</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small-label mb-0 me-2" for="sortBy">Sort</label>
            <select id="sortBy" class="form-select form-select-sm">
                <option value="">None</option>
                <option value="name:asc">Name ↑</option>
                <option value="name:desc">Name ↓</option>
                <option value="category:asc">Category ↑</option>
                <option value="category:desc">Category ↓</option>
                <option value="type:asc">Type ↑</option>
                <option value="type:desc">Type ↓</option>
            </select>
        </div>
        <div class="col-md-2 d-grid">
            <button type="button" id="clearFilters" class="btn btn-secondary">Clear</button>
        </div>
    </form>
</div>

<!-- Results table: displays filtered equipment list -->
<div class="card-panel">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="fw-semibold">Results</div>
        <div class="text-muted" id="resultCount" style="font-size:13px;">—</div>
    </div>

    <div class="table-responsive">
        <table class="table-darkish" id="equipTable">
            <thead>
                <tr>
                    <th>Asset ID</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th class="text-end">Value</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    var statusClass = e.EquipmentAvailability switch
                    {
                        "Available" => "pill-green",
                        "OutForRental" => "pill-blue",
                        "UnderMaintenance" => "pill-amber",
                        "Damaged" => "pill-red",
                        _ => "pill-gray"
                    };

                    <tr class="row-link"
                        tabindex="0"
                        data-category="@e.EquipmentCategory"
                        data-status="@e.EquipmentAvailability"
                        data-name="@e.EquipmentName"
                        data-code="@e.EquipmentCode"
                        data-type="@e.EquipmentType"
                        data-href="@Url.Action("Details", "Equipment", new { id = e.EquipmentCode })">
                        <td>@e.EquipmentCode</td>
                        <td>@e.EquipmentName</td>
                        <td>@e.EquipmentCategory</td>
                        <td>@e.EquipmentType</td>
                        <td>
                            <span class="pill @statusClass">
                                @e.EquipmentAvailability
                            </span>
                        </td>
                        <td class="text-end">
                            @e.EquipmentValue.ToString("C")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const table = document.getElementById('equipTable');
            if (!table) return;

                    const rows = Array.from(table.querySelectorAll('tbody tr'));
                    const inputQ = document.getElementById('q');
                    const selectCategory = document.getElementById('category');
                    const selectStatus = document.getElementById('status');
                    const selectSort = document.getElementById('sortBy');
                    const clearBtn = document.getElementById('clearFilters');
                    const resultCount = document.getElementById('resultCount');

                function applyFilters() {
                    const q = (inputQ.value || '').toLowerCase().trim();
                    const cat = selectCategory.value;
                    const status = selectStatus.value;
                    const sortValue = selectSort ? selectSort.value : '';
                    let visible = 0;
                    const visibleRows = [];


                    rows.forEach(row => {
                        const name = (row.dataset.name || '').toLowerCase();
                        const code = (row.dataset.code || '').toLowerCase();
                        const type = (row.dataset.type || '').toLowerCase();
                        const rowCat = row.dataset.category;
                        const rowStatus = row.dataset.status;

                    const matchesText =
                        !q ||
                        name.includes(q) ||
                        code.includes(q) ||
                        type.includes(q);

                    const matchesCat = cat === 'All' || rowCat === cat;
                    const matchesStatus = status === 'All' || rowStatus === status;

                            const show = matchesText && matchesCat && matchesStatus;

        row.style.display = show ? '' : 'none';
        if (show) {
            visible++;
            visibleRows.push(row);
        }
        });

        // Apply sorting to the visible rows only
        if (sortValue && visibleRows.length > 1) {
            const getCellText = (row, index) =>
                (row.cells[index]?.textContent || '').trim().toLowerCase();

            const compare = (a, b, index, direction) => {
                const va = getCellText(a, index);
                const vb = getCellText(b, index);
                if (va < vb) return direction === 'asc' ? -1 : 1;
                if (va > vb) return direction === 'asc' ? 1 : -1;
                return 0;
            };

            const [field, direction] = sortValue.split(':');

            visibleRows.sort((a, b) => {
                switch (field) {
                    case 'name':
                        // Name is the 2nd column (index 1)
                        return compare(a, b, 1, direction);
                    case 'category':
                        // Category is the 3rd column (index 2)
                        return compare(a, b, 2, direction);
                    case 'type':
                        // Type is the 4th column (index 3)
                        return compare(a, b, 3, direction);
                    default:
                        return 0;
                }
            });

            const tbody = table.querySelector('tbody');
            visibleRows.forEach(row => tbody.appendChild(row));
        }

        if (resultCount) {
            resultCount.textContent = `${visible} result${visible === 1 ? '' : 's'}`;
        }
            }

            function wireRowLinks() {
                rows.forEach(row => {
                    const href = row.dataset.href;
                    if (!href) return;

                    row.addEventListener('click', () => {
                        window.location.href = href;
                    });

                    row.addEventListener('keydown', e => {
                        if (e.key === 'Enter' || e.key === ' ') {
                            e.preventDefault();
                            window.location.href = href;
                        }
                    });
                });
            }

                    if (inputQ) inputQ.addEventListener('input', applyFilters);
        if (selectCategory) selectCategory.addEventListener('change', applyFilters);
        if (selectStatus) selectStatus.addEventListener('change', applyFilters);
        if (selectSort) selectSort.addEventListener('change', applyFilters);

        if (clearBtn) {
            clearBtn.addEventListener('click', () => {
                if (inputQ) inputQ.value = '';
                if (selectCategory) selectCategory.value = 'All';
                if (selectStatus) selectStatus.value = 'All';
                if (selectSort) selectSort.value = '';
                applyFilters();
            });
        }

        wireRowLinks();
        applyFilters();
        })();
    </script>
}
