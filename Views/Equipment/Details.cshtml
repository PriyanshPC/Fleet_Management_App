﻿@using System.Linq
@using Fleet_Management_App.Data.Entities
@model Equipment

@{
    ViewData["Title"] = $"Equipment Details • {Model.EquipmentCode}";

    string availabilityClass = Model.EquipmentAvailability switch
    {
        "Available" => "pill-green",
        "OutForRental" => "pill-blue",
        "UnderMaintenance" => "pill-amber",
        "Damaged" => "pill-red",
        _ => "pill-gray"
    };

    decimal DailyRate = @Model.EquipmentValue * 0.015m;
    decimal SecurityFee = Model.EquipmentValue * 0.10m;
    decimal DamageFee = Model.EquipmentValue * 0.25m;

    var latestRentedEquipment = Model.RentedEquipments
        ?.Where(re => re.Rental != null)
        .OrderByDescending(re => re.Rental!.StartDate)
        .FirstOrDefault();
}

<!-- Page header: shows title, description, and back navigation -->
<div class="page-head">
    <div>
        <h2 class="m-0">Equipment Details</h2>
        <div class="kicker">View technical information, rental history, and maintenance logs.</div>
    </div>
    <div class="d-flex align-items-center gap-2">
        <!-- Button to return to equipment list -->
        <a class="btn btn-secondary" asp-controller="Equipment" asp-action="List">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<div class="row g-3">
    <!-- LEFT COLUMN: Main equipment details, rental history, and maintenance log -->
    <div class="col-lg-9">

        <!-- Asset Information Card -->
        <div class="card-panel mb-3">
            <div class="fw-semibold mb-2">Asset Information</div>
            <div class="d-flex flex-wrap gap-5">
                <div>
                    <div class="small-label">Asset ID</div>
                    <div class="fw-semibold">@Model.EquipmentCode</div>
                </div>
                <div>
                    <div class="small-label">Name</div>
                    <div class="fw-semibold">@Model.EquipmentName</div>
                </div>
                <div>
                    <div class="small-label">Category</div>
                    <div class="fw-semibold">@Model.EquipmentCategory</div>
                </div>
                <div>
                    <div class="small-label">Type</div>
                    <div class="fw-semibold">@Model.EquipmentType</div>
                </div>
                <div>
                    <div class="small-label">Tracking ID</div>
                    <div class="fw-semibold">
                        @(string.IsNullOrWhiteSpace(Model.EquipmentTrackingId) ? "—" : Model.EquipmentTrackingId)
                    </div>
                </div>
                <div>
                    <div class="small-label">Status</div>
                    <span class="pill @availabilityClass">@Model.EquipmentAvailability</span>
                </div>
            </div>
            <hr class="dropdown-divider" />
            <!-- CHANGED: Value removed, Description added here -->
            <div class="text-muted" style="font-size:13px;">
                <span class="me-3">
                    <strong>Description:</strong>
                    @(string.IsNullOrWhiteSpace(Model.EquipmentDescription)
                                        ? "No description provided."
                                        : Model.EquipmentDescription)
                </span>
                @if (Model.Vehicle != null)
                {
                    <span class="me-3">
                        <strong>Vehicle:</strong> @Model.Vehicle.Year @Model.Vehicle.Make @Model.Vehicle.Model
                    </span>
                    @if (!string.IsNullOrWhiteSpace(Model.Vehicle.LicensePlate))
                    {
                        <span class="me-3">
                            <strong>Plate:</strong> @Model.Vehicle.LicensePlate
                        </span>
                    }
                }
            </div>
        </div>

        <!-- Rental History Card -->
        <div class="card-panel mb-3">
            <div class="fw-semibold mb-2">Rental History</div>
            @if (Model.RentedEquipments == null || Model.RentedEquipments.Count == 0)
            {
                <div class="text-muted" style="font-size:13px;">No rentals recorded for this asset yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table-darkish">
                        <thead>
                            <tr>
                                <!-- CHANGED: Rental ID -> Rental Code -->
                                <th>Rental Code</th>
                                <th>Client</th>
                                <th>Out</th>
                                <th>Due</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- CHANGED: Only past 5 rentals -->
                            @foreach (var re in Model.RentedEquipments.OrderByDescending(re => re.Rental!.StartDate).Take(5))
                            {
                                var rental = re.Rental;
                                if (rental == null)
                                {
                                    continue;
                                }

                                string pillClass = rental.Status switch
                                {
                                    "CheckedOut" => "pill-green",
                                    "Reserved" => "pill-amber",
                                    "Draft" => "pill-blue",
                                    "Returned" => "pill-gray",
                                    "Closed" => "pill-gray",
                                    _ => "pill-gray"
                                };

                                <tr>
                                    <!-- CHANGED: show RentalCode instead of RentalId -->
                                    <td>@rental.RentalCode</td>
                                    <td>@(rental.Customer?.CustomerName ?? "Internal")</td>
                                    <td>@rental.StartDate.ToString("yyyy-MM-dd")</td>
                                    <td>@rental.EndDate.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <!-- Status already shown as pill -->
                                        <span class="pill @pillClass">@rental.Status</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- Maintenance Log Card (Past 5) -->
        <div class="card-panel mb-3">
            <div class="fw-semibold mb-2">Maintenance Log</div>
            @if (Model.MaintenanceEvents == null || Model.MaintenanceEvents.Count == 0)
            {
                <div class="text-muted" style="font-size:13px;">No maintenance events recorded for this asset yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table-darkish">
                        <thead>
                            <tr>
                                <th>Opened</th>
                                <th>Last Service</th>
                                <th>Next Due</th>
                                <th>Status</th>
                                <th>Outcome</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- CHANGED: Only past 5 maintenance events -->
                            @foreach (var m in Model.MaintenanceEvents.OrderByDescending(m => m.OpenedAt).Take(5))
                            {
                                string mClass = m.EventStatus == "Open"
                                ? "pill-amber"
                                : "pill-green";

                                <tr>
                                    <td>@m.OpenedAt.ToString("yyyy-MM-dd")</td>
                                    <td>@m.LastServiceDate.ToString("yyyy-MM-dd")</td>
                                    <td>@(m.NextServiceDue.HasValue? m.NextServiceDue.Value.ToString("yyyy-MM-dd") : "—")</td>
                                    <td>
                                        <span class="pill @mClass">@m.EventStatus</span>
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(m.MaintenanceOutcome) ? "—" : m.MaintenanceOutcome)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- RIGHT COLUMN -->
    <div class="col-lg-3">
        <!-- CHANGED: Current Status card -> Pricing card -->
        <div class="card-panel mb-3">
            <div class="fw-semibold mb-2">Pricing</div>
            <div style="font-size:16px;">
                <div>
                    <div class="medium-label">Asset Value:</div>
                    <div class="fw-semibold">@Model.EquipmentValue.ToString("C")</div>
                </div>
                <br/>
                <div>
                    <div class="medium-label">Asset Daily Rate:</div>
                    <div class="fw-semibold">@DailyRate.ToString("C")</div>
                </div>
                <br />
                <div>
                    <div class="medium-label">Asset Security Fees:</div>
                    <div class="fw-semibold">@SecurityFee.ToString("C")</div>
                </div>
                <br />
                <div>
                    <div class="medium-label">Asset Damage Fees:</div>
                    <div class="fw-semibold">@DamageFee.ToString("C")</div>
                </div>
            </div>
        </div>
    </div>
</div>
