@using System.Linq
@using Fleet_Management_App.Entities
@using Fleet_Management_App.Models
@model EquipmentDetailsViewModel

@{
    var eq = Model.Equipment;

    // Use type as the "name" in the browser title
    ViewData["Title"] = $"Equipment Details • {eq.EquipmentType}";

    decimal GetRatePercent(decimal value)
    {
        if (value >= 80000m) return 0.015m; // 1.5%
        if (value >= 50000m) return 0.020m; // 2.0%
        if (value >= 20000m) return 0.030m; // 3.0%
        if (value >= 10000m) return 0.040m; // 4.0%
        return 0.050m;                      // 5.0%
    }

    var ratePercent = GetRatePercent(eq.EquipmentValue);
    decimal DailyRate = eq.EquipmentValue * ratePercent;
    decimal SecurityFee = eq.EquipmentValue * 0.10m;
    decimal DamageFee = eq.EquipmentValue * 0.25m;

    // Short type code from this unit (e.g., EQ-PUP from EQ-PUP-001)
    string typeCode = eq.EquipmentCode ?? string.Empty;
    var lastDash = typeCode.LastIndexOf('-');
    if (lastDash > 0)
    {
        typeCode = typeCode.Substring(0, lastDash);
    }

    var units = Model.UnitsOfType
        .OrderBy(u => u.EquipmentCode)
        .ToList();

    var availableCount = units.Count(u => u.EquipmentAvailability == "Available");
}

<!-- Page header -->
<div class="page-head">
    <div>
        <h2 class="m-0">Equipment Details</h2>
        <div class="kicker">
            Type overview, pricing, and live availability for this equipment family.
        </div>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a class="btn btn-secondary" asp-controller="Equipment" asp-action="List">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<div class="row g-3">
    <!-- LEFT COLUMN: Equipment information + units of this type -->
    <div class="col-lg-9">

        <!-- Equipment Information Card (now includes pricing) -->
        <div class="card-panel mb-3">
            <div class="fw-semibold mb-2">Equipment Information</div>

            <div class="d-flex flex-wrap gap-5">
                <div>
                    <div class="small-label">Type Code</div>
                    <div class="fw-semibold">@typeCode</div>
                </div>

                <div>
                    <div class="small-label">Category</div>
                    <div class="fw-semibold">@eq.EquipmentCategory</div>
                </div>

                <div>
                    <div class="small-label">Type</div>
                    <div class="fw-semibold">@eq.EquipmentType</div>
                </div>

                <div>
                    <div class="small-label">Available Equipments</div>
                    <div class="fw-semibold">@availableCount</div>
                </div>
            </div>

            <hr class="dropdown-divider" />

            <!-- Description -->
            <div class="mb-2" style="font-size:13px;">
                <div class="small-label mb-1">Description</div>
                <div class="text-muted">
                    @(!string.IsNullOrWhiteSpace(eq.EquipmentDescription)
                                        ? eq.EquipmentDescription
                                        : "No description has been added for this equipment type yet.")
                </div>
            </div>

            <hr class="dropdown-divider" />

            <!-- Pricing (moved into the same card) -->
            <div>
                <div class="fw-semibold mb-2">Pricing</div>
                <div class="d-flex flex-wrap gap-4" style="font-size:14px;">
                    <div>
                        <div class="medium-label">Equipment Value</div>
                        <div class="fw-semibold">@eq.EquipmentValue.ToString("C")</div>
                    </div>

                    <div>
                        <div class="medium-label">
                            Daily Rate
                            <span class="text-muted" style="font-size:11px;">
                                (@((ratePercent * 100m).ToString("0.#"))%)
                            </span>
                        </div>
                        <div class="fw-semibold">@DailyRate.ToString("C")</div>
                    </div>

                    <div>
                        <div class="medium-label">Security Fee</div>
                        <div class="fw-semibold">@SecurityFee.ToString("C")</div>
                    </div>

                    <div>
                        <div class="medium-label">Damage Fee</div>
                        <div class="fw-semibold">@DamageFee.ToString("C")</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Units in this equipment type -->
        <div class="card-panel mb-3">
            <div class="fw-semibold mb-2">Units in this Equipment Type</div>

            @if (units == null || !units.Any())
            {
                <div class="text-muted" style="font-size:13px;">
                    No units have been registered for this equipment type yet.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table-darkish">
                        <thead>
                            <tr>
                                <th>Equipment ID</th>
                                <th>Tracking ID</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in units)
                            {
                                string unitAvailabilityClass = u.EquipmentAvailability switch
                                {
                                    "Available" => "pill-green",
                                    "OutForRental" => "pill-blue",
                                    "UnderMaintenance" => "pill-amber",
                                    "Damaged" => "pill-red",
                                    _ => "pill-gray"
                                };

                                <tr>
                                    <td>@u.EquipmentCode</td>
                                    <td>
                                        @(string.IsNullOrWhiteSpace(u.EquipmentTrackingId)
                                                                        ? "—"
                                                                        : u.EquipmentTrackingId)
                            </td>
                            <td>
                                <span class="pill @unitAvailabilityClass">@u.EquipmentAvailability</span>
                            </td>
                        </tr>
                                                }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- RIGHT COLUMN: left intentionally empty to keep layout structure consistent -->
    <div class="col-lg-3">
        <!-- (no pricing card anymore) -->
    </div>
</div>
