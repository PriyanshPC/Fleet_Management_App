@model Fleet_Management_App.Models.DashboardViewModel
@using System.Linq

@{
    // Set the page title for the dashboard view
    ViewData["Title"] = "Dashboard";

    // Delta color helpers for KPI chips
    string rentalsDeltaClass = Model.Kpi.ActiveRentalsTodayDelta >= 0 ? "delta-up" : "delta-down";
    string maintDeltaClass = Model.Kpi.PendingMaintDelta >= 0 ? "delta-up" : "delta-down";

    // Maintenance donut breakdown: [OK, Scheduled, Urgent]
    int maintOk = Model.MaintDonut.Count > 0 ? Model.MaintDonut[0] : 0;
    int maintScheduled = Model.MaintDonut.Count > 1 ? Model.MaintDonut[1] : 0;
    int maintUrgent = Model.MaintDonut.Count > 2 ? Model.MaintDonut[2] : 0;
}

<!-- Page header: displays dashboard title and quick action button -->
<div class="page-head">
    <div>
        <h2 class="m-0">Dashboard</h2>
        <div class="kicker">Overview of fleet, rentals, and maintenance.</div>
    </div>
    <div class="d-flex align-items-center gap-2">
        <!-- Button to create a new rental, links to Rentals/New -->
        <a class="btn btn-green d-inline-flex align-items-center gap-2"
           asp-controller="Rentals" asp-action="New">
            <i class="bi bi-plus-lg"></i> New Rental
        </a>
    </div>
</div>

<!-- KPI SECTION: shows summary statistics for fleet management -->
<div class="stat-grid mb-3">
    <!-- Total equipment in the fleet -->
    <div class="stat-card">
        <div class="stat-eyebrow">Total Equipment</div>
        <div class="mt-1 d-flex align-items-center">
            <div class="stat-value">@Model.Kpi.TotalEquipment</div>
            <span class="stat-delta delta-up">
                @Model.Kpi.AddedThisWeek this week
            </span>
        </div>
        <div class="text-muted mt-2" style="font-size:13px;">
            Across @Model.Availability.Count categories
        </div>
    </div>

    <!-- Active rentals -->
    <div class="stat-card">
        <div class="stat-eyebrow">Active Rentals</div>
        <div class="mt-1 d-flex align-items-center">
            <div class="stat-value">@Model.Kpi.ActiveRentals</div>
            <span class="stat-delta @rentalsDeltaClass">
                @Model.Kpi.ActiveRentalsTodayDelta today
            </span>
        </div>
        <div class="text-muted mt-2" style="font-size:13px;">
            Monitoring current external &amp; internal jobs
        </div>
    </div>

    <!-- Pending maintenance items -->
    <div class="stat-card">
        <div class="stat-eyebrow">Pending Maintenance</div>
        <div class="mt-1 d-flex align-items-center">
            <div class="stat-value">@Model.Kpi.PendingMaintenance</div>
            <span class="stat-delta @maintDeltaClass">
                @Model.Kpi.PendingMaintDelta
            </span>
        </div>
        <div class="text-muted mt-2" style="font-size:13px;">
            @maintUrgent urgent items
        </div>
    </div>

    <!-- Fleet availability stats -->
    <div class="stat-card">
        <div class="stat-eyebrow">Fleet Available</div>
        <div class="mt-1 d-flex align-items-center">
            <div class="stat-value">@Model.Kpi.FleetAvailable</div>
            <span class="pill pill-blue ms-2">
                @Model.Kpi.FleetAvailablePct%
            </span>
        </div>
        <div class="text-muted mt-2" style="font-size:13px;">
            Including PPE, Vehicles, Drones
        </div>
    </div>
</div>

<!-- MAIN CONTENT ROW: charts and table -->
<div class="row g-3">
    <!-- Availability by category bar chart -->
    <div class="col-lg-6">
        <div class="card-panel">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div class="fw-semibold">Availability by Category</div>
                <span class="text-muted" style="font-size:12px;">
                    Live from database
                </span>
            </div>
            <div class="chart-wrap">
                <canvas id="chartAvailability"></canvas>
            </div>
        </div>
    </div>

    <!-- Doughnut chart: maintenance status overview -->
    <div class="col-lg-6">
        <div class="card-panel">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div class="fw-semibold">Maintenance Status</div>
                <span class="text-muted" style="font-size:12px;">
                    Live from database
                </span>
            </div>
            <div class="chart-wrap">
                <canvas id="chartMaintenance"></canvas>
            </div>
        </div>
    </div>

    <!-- ACTIVE RENTALS TABLE: lists current rentals with status -->
    <div class="col-12">
        <div class="card-panel">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div class="fw-semibold">Active and Upcoming Rentals</div>
                <!-- Link to view all rentals -->
                <a class="link-muted" asp-controller="Rentals" asp-action="List" style="font-size:13px;">View all</a>
            </div>

            <div class="table-responsive">
                <table class="table-darkish">
                    <thead>
                        <tr>
                            <th>Rental ID</th>
                            <th>Client</th>
                            <th>Items</th>
                            <th>Out</th>
                            <th>Due</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ActiveRentals != null && Model.ActiveRentals.Any())
                        {
                            foreach (var r in Model.ActiveRentals)
                            {
                                // Map status text → pill CSS class
                                var pillClass = r.Status switch
                                {
                                    "On Rent" => "pill-blue",
                                    "Due Soon" => "pill-amber",
                                    "Overdue" => "pill-red",
                                    "Scheduled" => "pill-green",
                                    "Cancelled" => "pill-darkred",
                                    _ => "pill-dark"
                                };

                                <tr class="row-link"
                                    tabindex="0"
                                    data-href="@Url.Action("List", "Rentals")">
                                    <td>@r.RentalCode</td>
                                    <td>@r.Client</td>
                                    <td>@r.Notes</td>
                                    <td>@r.OutDate</td>
                                    <td>@r.DueDate</td>
                                    <td>
                                        <span class="pill @pillClass">@r.Status</span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-3">
                                    No active rentals at the moment.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Chart.js library for rendering dashboard charts -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        // ====== Data from server (Model) ======
        const availabilityLabels = @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(
                            Model.Availability.Select(a => a.Category)
                    )
            );

    const availabilityValues = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                        Model.Availability.Select(a => a.Available)
                )
        );

    const maintData = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(Model.MaintDonut)
        );

    // ====== Availability bar chart (original color preserved) ======
    const ctxA = document.getElementById('chartAvailability');
    if (ctxA) {
        new Chart(ctxA, {
            type: 'bar',
            data: {
                labels: availabilityLabels,
                datasets: [{
                    label: 'Available',
                    data: availabilityValues,
                    backgroundColor: 'rgba(30,111,255,0.8)', // original blue
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    x: {
                        grid: { color: 'rgba(255,255,255,.05)' },
                        ticks: { color: '#B8BCC7' }
                    },
                    y: {
                        grid: { color: 'rgba(255,255,255,.05)' },
                        ticks: { color: '#B8BCC7' },
                        beginAtZero: true
                    }
                },
                plugins: {
                    legend: { display: false }
                }
            }
        });
    }

        // ====== Maintenance status donut chart (original colors preserved) ======
        const ctxM = document.getElementById('chartMaintenance');
        if (ctxM) {
            new Chart(ctxM, {
                type: 'doughnut',
                data: {
                    labels: ['OK', 'Scheduled', 'Urgent'],
                    datasets: [{
                        data: maintData,
                        backgroundColor: ['#22C55E', '#F59E0B', '#EF4444'], // green, amber, red
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '60%',
                    plugins: {
                        legend: {
                            labels: { color: '#B8BCC7' }
                        }
                    }
                }
            });
        }

        // Enable row click and keyboard navigation for rental details
        (function attachRowLinks() {
            document.querySelectorAll('tr.row-link[data-href]').forEach(tr => {
                tr.addEventListener('click', () => {
                    const href = tr.dataset.href;
                    if (href) {
                        location.href = href;
                    }
                });
                tr.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter' || e.key === ' ') {
                        e.preventDefault();
                        tr.click();
                    }
                });
            });
        })();
    </script>
}
