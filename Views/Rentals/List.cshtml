@model IEnumerable<Fleet_Management_App.Models.RentalListViewModel>

@{
    ViewData["Title"] = "Rentals – List";

    var statuses = new[] { "All", "Reserved", "Checked Out", "Returned", "Overdue", "Closed" };
}

<div class="page-head">
    <div>
        <h2 class="m-0">Rentals</h2>
        <div class="kicker">Search, filter, and manage active &amp; past rentals.</div>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a class="btn btn-green d-inline-flex align-items-center gap-2"
           asp-controller="Rentals" asp-action="New">
            <i class="bi bi-plus-lg"></i> New Rental
        </a>
    </div>
</div>

<div class="card-panel mb-3">
    <form id="filterForm" class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label small-label">Search</label>
            <input id="q" class="form-control" placeholder="Rental ID, customer…" />
        </div>
        <div class="col-md-3">
            <label class="form-label small-label">Status</label>
            <select id="status" class="form-select">
                @foreach (var s in statuses)
                {
                    <option>@s</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small-label">Out From</label>
            <input id="from" type="date" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label small-label">Due Until</label>
            <input id="to" type="date" class="form-control" />
        </div>
        <div class="col-md-1 d-grid">
            <button type="button" id="clearFilters" class="btn btn-secondary">Clear</button>
        </div>
    </form>
</div>

<div class="card-panel">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="fw-semibold">Results</div>
        <div class="text-muted" id="resultCount" style="font-size:13px;">
            @Model.Count() results
        </div>
    </div>

    <div class="table-responsive">
        <table class="table-darkish" id="rentalsTable">
            <thead>
                <tr>
                    <th>Rental ID</th>
                    <th>Customer</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    var startIso = r.StartDate.ToString("yyyy-MM-dd");
                    var endIso = r.EndDate.ToString("yyyy-MM-dd");

                    <tr class="row-link"
                        tabindex="0"
                        data-href="@Url.Action("Details", "Rentals", new { id = r.RentalId })"
                        data-start="@startIso"
                        data-end="@endIso">
                        <td>@r.RentalCode</td>
                        <td>@r.CustomerName</td>
                        <td>@r.StartDate.ToString("MMM dd")</td>
                        <td>@r.EndDate.ToString("MMM dd")</td>
                        <td>
                            @{
                                var css = r.Status switch
                                {
                                    "Reserved" => "pill pill-green",
                                    "Checked Out" => "pill pill-blue",
                                    "Returned" => "pill pill-gray",
                                    "Overdue" => "pill pill-red",
                                    "Closed" => "pill pill-gray",
                                    _ => "pill"
                                };
                            }
                            <span class="@css">@r.Status</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        (function attachRowLinks() {
            document.querySelectorAll('#rentalsTable tbody tr.row-link[data-href]').forEach(tr => {
                tr.addEventListener('click', () => location.href = tr.dataset.href);
                tr.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); tr.click(); }
                });
            });
        })();

        // Use ISO dates from data attributes to avoid locale/time issues
        function applyFilters() {
            const q = document.getElementById('q').value.trim().toLowerCase();
            const s = document.getElementById('status').value;
            const fromVal = document.getElementById('from').value; // yyyy-MM-dd or ""
            const toVal   = document.getElementById('to').value;   // yyyy-MM-dd or ""

            let visible = 0;

            document.querySelectorAll('#rentalsTable tbody tr').forEach(tr => {
                const tds = tr.children;
                const idTxt    = tds[0].textContent.trim().toLowerCase();
                const customer = tds[1].textContent.trim().toLowerCase();
                const statusTxt= tds[4].textContent.trim();

                const startIso = tr.dataset.start || ""; // yyyy-MM-dd
                const endIso   = tr.dataset.end || "";   // yyyy-MM-dd

                // Text search
                const matchQ = !q || idTxt.includes(q) || customer.includes(q);

                // Status filter
                const matchStatus = (s === 'All') || (statusTxt === s);

                // Date range filter – simple string comparison because all are yyyy-MM-dd
                let matchFrom = true;
                if (fromVal && startIso) {
                    matchFrom = startIso >= fromVal;
                }

                let matchTo = true;
                if (toVal && endIso) {
                    matchTo = endIso <= toVal;
                }

                const show = matchQ && matchStatus && matchFrom && matchTo;

                tr.style.display = show ? '' : 'none';
                if (show) visible++;
            });

            document.getElementById('resultCount').textContent =
                `${visible} result${visible === 1 ? '' : 's'}`;
        }

        ['q', 'status', 'from', 'to'].forEach(id => {
            const el = document.getElementById(id);
            if (el) {
                el.addEventListener('input', applyFilters);
                el.addEventListener('change', applyFilters);
            }
        });

        document.getElementById('clearFilters').addEventListener('click', () => {
            document.getElementById('q').value = '';
            document.getElementById('status').value = 'All';
            document.getElementById('from').value = '';
            document.getElementById('to').value = '';
            applyFilters();
        });

        // Initial run so the count is correct
        applyFilters();
    </script>
}
