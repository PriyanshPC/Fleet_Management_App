@{
    ViewData["Title"] = "New Rental";
}

<!-- Page header with title and navigation back to the rental list -->
<div class="page-head">
    <div>
        <h2 class="m-0">New Rental</h2>
        <div class="kicker">Create a new rental with customer, schedule, and items.</div>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a class="btn btn-secondary" asp-controller="Rentals" asp-action="List">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<style>
    /* Make disabled inputs look like part of the dark UI, not bright white */
    #newRentalForm .form-control:disabled,
    #newRentalForm .form-select:disabled {
        background-color: #2b2f3a;
        border-color: #3a3f4d;
        color: #adb5bd;
        opacity: 1; /* don't fade them out */
    }

    /* Make date-picker calendar icon white */
    input[type="date"]::-webkit-calendar-picker-indicator {
        filter: invert(1);
    }
</style>

<!-- Main content container -->
<form id="newRentalForm" autocomplete="off">
    <div class="row g-3">

        <!-- LEFT COLUMN: Customer, rental details, notes -->
        <div class="col-lg-8">

            <!-- Customer Information -->
            <div class="card-panel mb-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="fw-semibold">Customer Information</div>
                </div>

                <input type="hidden" id="customerId" />

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label small-label">Customer Name</label>
                        <input id="customerName" class="form-control" placeholder="Customer Name" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small-label">Email</label>
                        <input id="customerEmail" type="email" class="form-control" placeholder="email@example.com" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small-label">Phone</label>
                        <!-- Numeric-only phone input -->
                        <input id="customerPhone"
                               type="tel"
                               inputmode="numeric"
                               pattern="[0-9]*"
                               class="form-control"
                               placeholder="10-digit phone"
                               maxlength="10" />
                    </div>

                    <div class="col-md-8">
                        <label class="form-label small-label">Address</label>
                        <input id="customerAddress" class="form-control" placeholder="Customer address" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small-label">Government ID</label>
                        <input id="customerGovtId" class="form-control" placeholder="Govt ID" />
                    </div>
                </div>
            </div>

            <!-- Rental Details -->
            <div class="card-panel mb-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="fw-semibold">Rental Details</div>
                    <div class="d-flex gap-2">
                        <!-- Buttons styled like original Items card: secondary + danger with icons -->
                        <button type="button" id="addEquipmentBtn" class="btn btn-primary btn-sm" disabled>
                            <i class="bi bi-plus-lg"></i> Add Equipment
                        </button>
                        <button type="button" id="clearEquipmentBtn" class="btn btn-danger btn-sm" disabled>
                            <i class="bi bi-trash3"></i> Clear
                        </button>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small-label">Start Date</label>
                        <input id="startDate"
                               type="date"
                               class="form-control"
                               disabled
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small-label">Return Date</label>
                        <input id="endDate"
                               type="date"
                               class="form-control"
                               disabled
                               min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" />
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table-darkish align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Category</th>
                                <th>Equipment</th>
                                <th style="width: 90px;">Qty</th>
                                <th class="text-end">Rate / Day</th>
                                <th class="text-end">Subtotal</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="itemsBody">
                            <tr class="no-items-row">
                                <td colspan="6" class="text-center text-muted">
                                    No Equipment Added, Click +Add Equipment to add an equipment
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Rental Notes -->
            <div class="card-panel mb-3">
                <label class="form-label small-label">Rental Notes</label>
                <textarea id="rentalNote"
                          class="form-control"
                          rows="3"
                          placeholder="Any handling, delivery, or return instructions..."></textarea>
            </div>

        </div>

        <!-- RIGHT COLUMN: Summary + Discount + Payment -->
        <div class="col-lg-4">

            <div class="card-panel">
                <div class="fw-semibold mb-2">Summary</div>

                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Total Items</span>
                    <span id="summaryTotalItems">0</span>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Subtotal</span>
                    <span id="summarySubtotal">$0.00</span>
                </div>
                <div class="d-flex justify-content-between mb-2 align-items-center">
                    <span class="text-muted">Discount</span>
                    <input id="discountInput"
                           class="form-control form-control-sm text-end"
                           style="max-width: 120px;"
                           value="0" />
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">HST (13%)</span>
                    <span id="summaryTax">$0.00</span>
                </div>

                <hr class="dropdown-divider" />

                <div class="d-flex justify-content-between fw-semibold mb-3">
                    <span>Total</span>
                    <span id="summaryGrandTotal">$0.00</span>
                </div>

                <div class="fw-semibold mb-2">Payment</div>

                <div class="mb-2">
                    <label class="form-label small-label">Name on Card</label>
                    <input id="cardName" class="form-control" placeholder="Full name as on card" />
                </div>

                <div class="mb-2">
                    <label class="form-label small-label">Card Number</label>
                    <input id="cardNumber"
                           class="form-control"
                           placeholder="16-digit card number"
                           inputmode="numeric"
                           pattern="[0-9]*"
                           maxlength="16" />
                </div>

                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label small-label">Exp (MMYY)</label>
                        <input id="cardExp"
                               class="form-control"
                               placeholder="MMYY"
                               inputmode="numeric"
                               pattern="[0-9]*"
                               maxlength="4" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small-label">CVV</label>
                        <input id="cardCvv"
                               class="form-control"
                               type="password"
                               placeholder="3 digits"
                               inputmode="numeric"
                               pattern="[0-9]*"
                               maxlength="3" />
                    </div>
                </div>

                <button type="submit"
                        class="btn btn-green w-100 mt-3 d-inline-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-check2-circle"></i> Create Rental
                </button>
            </div>

        </div>

    </div>
</form>

<!-- MESSAGE MODAL (matches dark popup style from maintenance) -->
<div class="modal fade" id="messageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content card-panel bg-dark text-light border-0">
            <div class="modal-header border-0">
                <h5 class="modal-title" id="messageModalTitle">Message</h5>
                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="messageModalBody" class="mb-0"></p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-primary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- PAYMENT OVERLAY (Processing → Contacting Bank → Validating → Approved/Denied) -->
<div id="paymentOverlay"
     class="position-fixed top-0 start-0 w-100 h-100 d-none"
     style="background: rgba(0,0,0,0.75); z-index: 2000;">
    <div class="d-flex justify-content-center align-items-center h-100">
        <div class="card-panel text-center p-4">
            <div id="paymentStatusIcon" class="mb-3">
                <div class="spinner-border text-light" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
            <div id="paymentStatusText" class="fw-semibold">Processing...</div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {

            // ---------- DOM references ----------
            const form = document.getElementById('newRentalForm');

            const customerIdInput = document.getElementById('customerId');
            const customerNameInput = document.getElementById('customerName');
            const customerEmailInput = document.getElementById('customerEmail');
            const customerPhoneInput = document.getElementById('customerPhone');
            const customerAddressInput = document.getElementById('customerAddress');
            const customerGovtIdInput = document.getElementById('customerGovtId');

            const startDateInput = document.getElementById('startDate');
            const endDateInput = document.getElementById('endDate');

            const addEquipmentBtn = document.getElementById('addEquipmentBtn');
            const clearEquipmentBtn = document.getElementById('clearEquipmentBtn');
            const itemsBody = document.getElementById('itemsBody');

            const noteInput = document.getElementById('rentalNote');

            const totalItemsSpan = document.getElementById('summaryTotalItems');
            const subtotalSpan = document.getElementById('summarySubtotal');
            const discountInput = document.getElementById('discountInput');
            const taxSpan = document.getElementById('summaryTax');
            const totalSpan = document.getElementById('summaryGrandTotal');

            // Payment fields
            const cardNameInput = document.getElementById('cardName');
            const cardNumberInput = document.getElementById('cardNumber');
            const cardExpInput = document.getElementById('cardExp');
            const cardCvvInput = document.getElementById('cardCvv');

            // Message modal
            const messageModalEl = document.getElementById('messageModal');
            const messageModalTitle = document.getElementById('messageModalTitle');
            const messageModalBody = document.getElementById('messageModalBody');
            let messageModalInstance = null;
            if (messageModalEl && window.bootstrap) {
                messageModalInstance = new bootstrap.Modal(messageModalEl);
            }

            function showMessage(title, body) {
                messageModalTitle.textContent = title || 'Message';
                messageModalBody.textContent = body || '';
                if (messageModalInstance) {
                    messageModalInstance.show();
                } else {
                    alert(body); // fallback
                }
            }

            // Payment overlay
            const paymentOverlay = document.getElementById('paymentOverlay');
            const paymentStatusIcon = document.getElementById('paymentStatusIcon');
            const paymentStatusText = document.getElementById('paymentStatusText');

            function showPaymentOverlay() {
                paymentOverlay.classList.remove('d-none');
            }

            function hidePaymentOverlay() {
                paymentOverlay.classList.add('d-none');
                paymentStatusIcon.innerHTML =
                    '<div class="spinner-border text-light" role="status"><span class="visually-hidden">Loading...</span></div>';
                paymentStatusText.textContent = 'Processing...';
            }

            // ---------- State ----------
            let equipmentCatalog = [];
            let lastPhoneLookupDigits = '';

            // ---------- Helpers ----------
            const digitsOnly = v => (v || '').replace(/\D/g, '');

            const money = n => n.toLocaleString(undefined, { style: 'currency', currency: 'CAD' });

            function rentalDays() {
                const s = startDateInput.value;
                const e = endDateInput.value;
                if (!s || !e) return 0;
                const start = new Date(s);
                const end = new Date(e);
                const diff = Math.round((end - start) / (1000 * 60 * 60 * 24)) + 1; // inclusive
                return Math.max(diff, 0);
            }

            function getTypeInfo(category, type) {
                return equipmentCatalog.find(x => x.category === category && x.type === type) || null;
            }

            function showNoItemsMessage() {
                if (!itemsBody.querySelector('.no-items-row')) {
                    const row = document.createElement('tr');
                    row.classList.add('no-items-row');
                    row.innerHTML =
                        '<td colspan="6" class="text-center text-muted">No Equipment Added, Click +Add Equipment to add an equipment</td>';
                    itemsBody.appendChild(row);
                }
            }

            function removeNoItemsMessage() {
                const row = itemsBody.querySelector('.no-items-row');
                if (row) {
                    row.remove();
                }
            }

            function updateRentalCardEnabled() {
                const required = [
                    customerNameInput,
                    customerPhoneInput,
                    customerAddressInput
                ];
                const allFilled = required.every(i => i && i.value.trim() !== '');

                const enableDates = allFilled;

                startDateInput.disabled = !enableDates;
                endDateInput.disabled = !enableDates;

                const enableItems =
                    enableDates &&
                    !!startDateInput.value &&
                    !!endDateInput.value;

                addEquipmentBtn.disabled = !enableItems;
                clearEquipmentBtn.disabled = itemsBody.querySelectorAll('tr:not(.no-items-row)').length === 0;
            }

            function updateSummary() {
                let totalItems = 0;
                let subtotal = 0;

                itemsBody.querySelectorAll('tr').forEach(row => {
                    if (row.classList.contains('no-items-row')) {
                        return;
                    }

                    const qtyInput = row.querySelector('.item-qty');
                    const subSpan = row.querySelector('.item-subtotal');

                    const qty = parseInt(qtyInput && qtyInput.value ? qtyInput.value : '0', 10);

                    const rawText = subSpan && subSpan.textContent
                        ? subSpan.textContent.replace(/[^0-9.\-]/g, '')
                        : '0';

                    const numeric = parseFloat(rawText || '0');

                    totalItems += isNaN(qty) ? 0 : qty;
                    subtotal += isNaN(numeric) ? 0 : numeric;
                });

                // Discount logic
                let discountAmount = 0;
                const discountRaw = (discountInput.value || '').trim();

                if (discountRaw.endsWith('%')) {
                    const pct = parseFloat(discountRaw.slice(0, -1));
                    if (!isNaN(pct) && pct > 0) {
                        discountAmount = subtotal * (pct / 100);
                    }
                } else if (discountRaw.length > 0) {
                    const val = parseFloat(discountRaw);
                    if (!isNaN(val) && val > 0) {
                        discountAmount = val;
                    }
                }

                if (discountAmount > subtotal) {
                    discountAmount = subtotal;
                }

                const discountedSubtotal = Math.max(subtotal - discountAmount, 0);
                const tax = discountedSubtotal * 0.13;
                const total = discountedSubtotal + tax;

                totalItemsSpan.textContent = totalItems.toString();
                subtotalSpan.textContent = money(subtotal);
                taxSpan.textContent = money(tax);
                totalSpan.textContent = money(total);
            }

            function wireRow(row) {
                const categorySelect = row.querySelector('.item-category');
                const typeSelect = row.querySelector('.item-type');
                const qtyInput = row.querySelector('.item-qty');
                const rateSpan = row.querySelector('.item-rate');
                const subtotalSpan = row.querySelector('.item-subtotal');
                const deleteBtn = row.querySelector('.item-delete');

                // Categories
                const categories = [...new Set(equipmentCatalog.map(x => x.category))];
                categorySelect.innerHTML =
                    '<option value="">Select...</option>' +
                    categories.map(c => `<option value="${c}">${c}</option>`).join('');

                categorySelect.addEventListener('change', () => {
                    const category = categorySelect.value;

                    const types = equipmentCatalog.filter(x => x.category === category);
                    typeSelect.disabled = !category;
                    typeSelect.innerHTML =
                        '<option value="">Select...</option>' +
                        types.map(t => `<option value="${t.type}">${t.type}</option>`).join('');

                    qtyInput.value = '';
                    qtyInput.disabled = true;
                    rateSpan.textContent = money(0);
                    subtotalSpan.textContent = money(0);
                    updateSummary();
                });

                typeSelect.addEventListener('change', () => {
                    const info = getTypeInfo(categorySelect.value, typeSelect.value);
                    if (info) {
                        rateSpan.textContent = money(info.dailyRate);
                        qtyInput.disabled = false;
                        qtyInput.max = info.available;
                    } else {
                        rateSpan.textContent = money(0);
                        qtyInput.disabled = true;
                    }

                    qtyInput.value = '';
                    subtotalSpan.textContent = money(0);
                    updateSummary();
                });

                qtyInput.addEventListener('input', () => {
                    const info = getTypeInfo(categorySelect.value, typeSelect.value);
                    if (!info) {
                        qtyInput.value = '';
                        subtotalSpan.textContent = money(0);
                        updateSummary();
                        return;
                    }

                    let qty = parseInt(qtyInput.value || '0', 10);
                    if (qty > info.available) {
                        qty = info.available;
                        qtyInput.value = String(qty);
                    } else if (qty < 0 || isNaN(qty)) {
                        qty = 0;
                        qtyInput.value = '';
                    }

                    const days = rentalDays();
                    const subtotal = info.dailyRate * days * qty;
                    subtotalSpan.textContent = money(subtotal);
                    updateSummary();
                });

                deleteBtn.addEventListener('click', () => {
                    row.remove();
                    if (itemsBody.querySelectorAll('tr:not(.no-items-row)').length === 0) {
                        showNoItemsMessage();
                    }
                    updateSummary();
                    updateRentalCardEnabled();
                });
            }

            function addEquipmentRow() {
                if (!startDateInput.value || !endDateInput.value) {
                    showMessage('Dates Required', 'Select Start Date and Return Date first.');
                    return;
                }

                if (!equipmentCatalog.length) {
                    showMessage('Equipment Loading', 'Equipment catalog is still loading. Please try again in a moment.');
                    return;
                }

                removeNoItemsMessage();

                const row = document.createElement('tr');
                row.innerHTML = `
                    <td>
                        <select class="form-select form-select-sm item-category">
                            <option value="">Select...</option>
                        </select>
                    </td>
                    <td>
                        <select class="form-select form-select-sm item-type" disabled>
                            <option value="">Select...</option>
                        </select>
                    </td>
                    <td>
                        <input type="number" min="1" class="form-control form-control-sm item-qty" disabled />
                    </td>
                    <td class="text-end">
                        <span class="item-rate">$0.00</span>
                    </td>
                    <td class="text-end">
                        <span class="item-subtotal">$0.00</span>
                    </td>
                    <td class="text-end">
                        <!-- Bin icon styled as a proper outline-danger button -->
                        <button type="button" class="btn btn-outline-danger btn-sm item-delete" title="Remove item">
                            <i class="bi bi-trash3"></i>
                        </button>
                    </td>
                `;

                itemsBody.appendChild(row);
                wireRow(row);
                updateRentalCardEnabled();
            }

            // Payment decision based on Stripe-style test cards:
            // 4242 4242 4242 4242 -> approved
            // 4000 0000 0000 0002 -> declined
            function getPaymentDecision(cardNumberDigits) {
                if (cardNumberDigits === '4000000000000002') {
                    return 'declined';
                }
                // default + 4242... and other test cards -> approved
                return 'approved';
            }

            function validateCardFields() {
                const name = (cardNameInput.value || '').trim();
                const number = digitsOnly(cardNumberInput.value);
                const exp = digitsOnly(cardExpInput.value);
                const cvv = digitsOnly(cardCvvInput.value);

                if (!name || name.split(' ').length < 2) {
                    showMessage('Payment Error', 'Please enter the full name on the card.');
                    return null;
                }

                if (number.length !== 16) {
                    showMessage('Payment Error', 'Card number must be 16 digits.');
                    return null;
                }

                if (exp.length !== 4) {
                    showMessage('Payment Error', 'Expiry must be 4 digits in MMYY format.');
                    return null;
                }

                const month = parseInt(exp.substring(0, 2), 10);
                const year = 2000 + parseInt(exp.substring(2, 4), 10);
                if (isNaN(month) || isNaN(year) || month < 1 || month > 12) {
                    showMessage('Payment Error', 'Expiry month must be between 01 and 12.');
                    return null;
                }

                const now = new Date();
                const thisMonth = now.getMonth() + 1;
                const thisYear = now.getFullYear();

                if (year < thisYear || (year === thisYear && month < thisMonth)) {
                    showMessage('Payment Error', 'Card expiry date cannot be in the past.');
                    return null;
                }

                if (cvv.length !== 3) {
                    showMessage('Payment Error', 'CVV must be 3 digits.');
                    return null;
                }

                return { name, number, exp, cvv };
            }

            function processPaymentAndCreateRental(decision, payload) {
                showPaymentOverlay();

                const stages = ['Processing', 'Contacting Bank', 'Validating Payment'];
                let idx = 0;

                function runStages() {
                    if (idx < stages.length) {
                        paymentStatusText.textContent = stages[idx];
                        idx++;
                        setTimeout(runStages, 800);
                    } else {
                        if (decision === 'declined') {
                            paymentStatusIcon.innerHTML =
                                '<i class="bi bi-x-circle-fill text-danger fs-2"></i>';
                            paymentStatusText.textContent = 'Payment Denied';

                            setTimeout(() => {
                                hidePaymentOverlay();
                                showMessage('Payment Denied',
                                    'Your card was declined. Please review the card details.');
                            }, 1200);

                            return;
                        }

                        // Approved path
                        paymentStatusIcon.innerHTML =
                            '<i class="bi bi-check-circle-fill text-success fs-2"></i>';
                        paymentStatusText.textContent = 'Approved';

                        fetch('@Url.Action("Create", "Rentals")', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify(payload)
                        })
                            .then(r => {
                                if (!r.ok) {
                                    return r.text().then(t => { throw new Error(t || 'Failed to create rental.'); });
                                }
                                return r.json();
                            })
                            .then(result => {
                                if (result && result.detailsUrl) {
                                    // Redirect to Details page after successful creation.
                                    window.location.href = result.detailsUrl;
                                } else {
                                    hidePaymentOverlay();
                                    showMessage('Rental Created',
                                        'Rental was created, but no redirect URL was returned.');
                                }
                            })
                            .catch(err => {
                                hidePaymentOverlay();
                                showMessage('Error', err.message || 'Error creating rental.');
                            });
                    }
                }

                runStages();
            }

            // ---------- Events ----------

            // Load equipment catalog on page load
            fetch('@Url.Action("EquipmentCatalog", "Rentals")')
                .then(r => r.ok ? r.json() : Promise.reject())
                .then(data => { equipmentCatalog = data || []; })
                .catch(() => {
                    console.warn('Could not load equipment catalog.');
                });

            // Phone: block non-numeric keypresses and handle lookup
            customerPhoneInput.addEventListener('keypress', (e) => {
                if (!/[0-9]/.test(e.key)) {
                    e.preventDefault();
                }
            });

            customerPhoneInput.addEventListener('paste', (e) => {
                const text = (e.clipboardData || window.clipboardData).getData('text');
                if (/[^0-9]/.test(text)) {
                    e.preventDefault();
                }
            });

            // Phone auto-lookup (after 10 digits)
            customerPhoneInput.addEventListener('input', () => {
                const digits = digitsOnly(customerPhoneInput.value);
                customerPhoneInput.value = digits; // keep field clean

                if (digits.length === 10 && digits !== lastPhoneLookupDigits) {
                    lastPhoneLookupDigits = digits;

                    fetch('@Url.Action("LookupCustomer", "Rentals")' + '?phone=' + encodeURIComponent(digits))
                        .then(r => r.ok ? r.json() : Promise.reject())
                        .then(data => {
                            if (data && data.found) {
                                showMessage('Customer Found', 'Customer Found! Details populated.');

                                customerIdInput.value = data.customerId || '';
                                customerNameInput.value = data.customerName || '';
                                customerEmailInput.value = data.customerEmail || '';
                                customerAddressInput.value = data.customerAddress || '';
                                customerGovtIdInput.value = data.customerGovtId || '';
                            } else {
                                showMessage('New Customer', 'No Customer Found, new customer will be created.');
                                customerIdInput.value = '';
                            }

                            updateRentalCardEnabled();
                        })
                        .catch(() => {
                            console.warn('Customer lookup failed.');
                        });
                } else if (digits.length < 10) {
                    lastPhoneLookupDigits = '';
                }

                updateRentalCardEnabled();
            });

            customerNameInput.addEventListener('input', updateRentalCardEnabled);
            customerAddressInput.addEventListener('input', updateRentalCardEnabled);

            // Keep return date at least 1 day after start date
            startDateInput.addEventListener('change', () => {
                if (startDateInput.value) {
                    const d = new Date(startDateInput.value);
                    d.setDate(d.getDate() + 1);
                    endDateInput.min = d.toISOString().split('T')[0];

                    if (endDateInput.value && endDateInput.value < endDateInput.min) {
                        endDateInput.value = endDateInput.min;
                    }
                } else {
                    endDateInput.min = '';
                    endDateInput.value = '';
                }

                updateRentalCardEnabled();
                // when dates change, recompute subtotals
                itemsBody.querySelectorAll('.item-qty').forEach(input => {
                    input.dispatchEvent(new Event('input'));
                });
            });

            endDateInput.addEventListener('change', () => {
                updateRentalCardEnabled();
                itemsBody.querySelectorAll('.item-qty').forEach(input => {
                    input.dispatchEvent(new Event('input'));
                });
            });

            addEquipmentBtn.addEventListener('click', addEquipmentRow);

            clearEquipmentBtn.addEventListener('click', () => {
                // clear all rows + dates
                itemsBody.innerHTML = '';
                showNoItemsMessage();
                startDateInput.value = '';
                endDateInput.value = '';
                updateSummary();
                updateRentalCardEnabled();
            });

            discountInput.addEventListener('input', updateSummary);

            // Card inputs: numeric-only where needed
            [cardNumberInput, cardExpInput, cardCvvInput].forEach(input => {
                input.addEventListener('keypress', (e) => {
                    if (!/[0-9]/.test(e.key)) {
                        e.preventDefault();
                    }
                });

                input.addEventListener('paste', (e) => {
                    const text = (e.clipboardData || window.clipboardData).getData('text');
                    if (/[^0-9]/.test(text)) {
                        e.preventDefault();
                    }
                });
            });

            // Main submit → validate → simulate payment → if approved, call Create
            form.addEventListener('submit', function (e) {
                e.preventDefault();

                const days = rentalDays();
                if (days <= 0) {
                    showMessage('Invalid Dates', 'Return Date must be on or after the Start Date.');
                    return;
                }

                if (!customerNameInput.value.trim()) {
                    showMessage('Missing Info', 'Please enter the customer name.');
                    return;
                }

                if (digitsOnly(customerPhoneInput.value).length !== 10) {
                    showMessage('Invalid Phone', 'Phone number must be 10 digits.');
                    return;
                }

                const rows = itemsBody.querySelectorAll('tr:not(.no-items-row)');
                if (rows.length === 0) {
                    showMessage('No Equipment', 'Add at least one equipment item.');
                    return;
                }

                const items = [];
                rows.forEach(row => {
                    const category = row.querySelector('.item-category')?.value || '';
                    const type = row.querySelector('.item-type')?.value || '';
                    const qtyVal = row.querySelector('.item-qty')?.value || '0';
                    const qty = parseInt(qtyVal, 10);

                    const info = getTypeInfo(category, type);

                    if (category && type && info && qty > 0) {
                        items.push({
                            category: category,
                            type: type,
                            quantity: qty,
                            dailyRate: info.dailyRate
                        });
                    }
                });

                if (!items.length) {
                    showMessage('Incomplete Rows', 'Please complete at least one valid equipment row.');
                    return;
                }

                const cardData = validateCardFields();
                if (!cardData) {
                    return; // message already shown
                }

                const payload = {
                    customerId: customerIdInput.value || null,
                    customerName: customerNameInput.value.trim(),
                    customerEmail: customerEmailInput.value.trim() || null,
                    customerPhone: digitsOnly(customerPhoneInput.value),
                    customerAddress: customerAddressInput.value.trim() || null,
                    customerGovtId: customerGovtIdInput.value.trim() || null,
                    startDate: startDateInput.value,
                    endDate: endDateInput.value,
                    note: noteInput.value.trim() || null,
                    items: items
                };

                const decision = getPaymentDecision(cardData.number);
                processPaymentAndCreateRental(decision, payload);
            });

            // Initial state
            updateRentalCardEnabled();
            updateSummary();
            showNoItemsMessage();

        })();
    </script>
}
