@model Fleet_Management_App.Models.RentalDetailsViewModel

@{
    ViewData["Title"] = "Rental Details";
}

<style>
    /* BACKDROP */
    .modal-backdrop-custom {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0, 0, 0, 0.55);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 2000;
    }

    /* MODAL CARD */
    .modal-card-custom {
        background: #1c1f26;
        color: #fff;
        width: 450px;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.45);
        animation: fadeIn 0.15s ease-out;
    }

    /* MODAL HEADER */
    .modal-header-custom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 1.15rem;
        margin-bottom: 12px;
    }

    .modal-title-custom {
        font-weight: 600;
    }

    .modal-close-btn {
        background: transparent;
        border: none;
        color: #aaa;
        font-size: 1.2rem;
        cursor: pointer;
    }

    /* BODY */
    .modal-body-custom {
        margin-bottom: 20px;
        font-size: 0.95rem;
        color: #ddd;
    }

    /* FOOTER */
    .modal-footer-custom {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }
</style>


<div class="page-head">
    <div>
        <h2 class="m-0">Rental Details</h2>
        <div class="kicker">View rental information, items, and available actions.</div>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a class="btn btn-secondary" asp-controller="Rentals" asp-action="List">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>

@{
    var statusCss = Model.UiStatus switch
    {
        "Reserved" => "pill pill-green",
        "Checked Out" => "pill pill-blue",
        "Returned" => "pill pill-gray",
        "Overdue" => "pill pill-red",
        "Closed" => "pill pill-gray",
        _ => "pill"
    };
}

<div class="row g-3">
    <!-- LEFT SIDE -->
    <div class="col-lg-8">

        <!-- Rental Details Card -->
        <div class="card-panel mb-3">
            <div class="fw-semibold mb-3">Rental Details</div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label small-label">Rental ID</label>
                    <div>@Model.RentalCode</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label small-label">Customer Name</label>
                    <div>@Model.CustomerName</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label small-label">Customer Phone</label>
                    <div>@Model.CustomerPhone</div>
                </div>
            </div>

            <div class="row mb-1">
                <div class="col-md-4">
                    <label class="form-label small-label">Status</label>
                    <div><span class="@statusCss">@Model.UiStatus</span></div>
                </div>
                <div class="col-md-4">
                    <label class="form-label small-label">Out Date</label>
                    <div>@Model.StartDate.ToString("yyyy-MM-dd")</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label small-label">Due Date</label>
                    <div>@Model.EndDate.ToString("yyyy-MM-dd")</div>
                </div>
            </div>
        </div>

        <!-- Rented Equipment -->
        <div class="card-panel mb-3">
            <div class="fw-semibold mb-3">Rented Equipments</div>

            <div class="table-responsive">
                <table class="table-darkish">
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th>Equipment</th>
                            <th>QTY</th>
                            <th>Rate/Day</th>
                            <th>Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in Model.Lines)
                        {
                            <tr>
                                <td>@line.Category</td>
                                <td>@line.Type</td>
                                <td>@line.Quantity</td>
                                <td>@line.DailyRate.ToString("C")</td>
                                <td>@line.Subtotal.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                    <thead>
                        <tr>
                            <td colspan="3"></td>
                            <th>Subtotal: </th>
                            <th><strong>@Model.Subtotal.ToString("C")</strong></th>
                        </tr>
                        <tr>
                            <td colspan="3"></td>
                            <th>HST (13%): </th>
                            <th><strong>@Model.Tax.ToString("C")</strong></th>
                        </tr>
                        <tr>
                            <td colspan="3"></td>
                            <th>Total: </th>
                            <th><strong>@Model.Total.ToString("C")</strong></th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>

        <!-- Notes -->
        <div class="card-panel mb-3">
            <div class="fw-semibold mb-3">Rental Notes</div>
            @if (!string.IsNullOrWhiteSpace(Model.Note))
            {
                <p>@Model.Note</p>
            }
            else
            {
                <p class="text-muted">No notes recorded for this rental.</p>
            }
        </div>

    </div>

    <!-- ACTIONS COLUMN -->
    <div class="col-lg-4">
        @if (!string.Equals(Model.UiStatus, "Closed", StringComparison.OrdinalIgnoreCase))
        {
            <div class="card-panel mb-3">
                <div class="fw-semibold">Actions</div>
                <div class="text-muted small mb-3">Available actions based on rental status</div>

                @using (Html.BeginForm("UpdateStatus", "Rentals", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.Hidden("id", Model.RentalId)

                    <div class="row row-cols-2 g-2">

                        <!-- RESERVED -->
                        @if (Model.UiStatus == "Reserved")
                        {
                            <button type="button"
                                    class="btn btn-primary w-100"
                                    onclick="window.location.href='@Url.Action("Edit", "Rentals", new { id = Model.RentalId })'">
                                Edit Rental
                            </button>


                            <div class="col">
                                <button type="button"
                                        class="btn btn-success w-100"
                                        onclick="openConfirmModal('btnCheckedOut', 'Mark this rental as Checked Out?')">
                                    Checked Out
                                </button>
                                <button id="btnCheckedOut"
                                        type="submit"
                                        name="actionType"
                                        value="CheckedOut"
                                        class="d-none">
                                </button>
                            </div>

                            <div class="col">
                                <button type="button"
                                        class="btn btn-danger w-100"
                                        onclick="openConfirmModal('btnCancel', 'Cancel and remove this rental?')">
                                    Cancel
                                </button>
                                <button id="btnCancel"
                                        type="submit"
                                        name="actionType"
                                        value="Cancel"
                                        class="d-none">
                                </button>
                            </div>
                        }

                       <!-- CHECKED OUT -->
                        @if (Model.UiStatus == "Checked Out")
                        {
                            <button type="button"
                                    class="btn btn-primary w-100"
                                    onclick="window.location.href='@Url.Action("Edit", "Rentals", new { id = Model.RentalId })'">
                                Edit Rental
                            </button>


                            <div class="col">
                                <button type="button"
                                        class="btn btn-secondary w-100"
                                        onclick="openConfirmModal('btnReturned', 'Mark this rental as Returned and move all items to maintenance?')">
                                    Returned
                                </button>
                                <button id="btnReturned"
                                        type="submit"
                                        name="actionType"
                                        value="Returned"
                                        class="d-none">
                                </button>
                            </div>
                        }

                        <!-- RETURNED -->
                        @if (Model.UiStatus == "Returned")
                        {
                            <div class="col">
                                <button class="btn btn-primary w-100" disabled>Review</button>
                            </div>
                        }

                        <!-- OVERDUE SCENARIO 1 -->
                        @if (Model.UiStatus == "Overdue" && Model.IsOverdueScenario1)
                        {
                            <div class="col">
                                <button class="btn btn-danger w-100" disabled>Charge</button>
                            </div>
                        }

                        <!-- OVERDUE SCENARIO 2 -->
                        @if (Model.UiStatus == "Overdue" && Model.IsOverdueScenario2)
                        {
                            <div class="col">
                                <button class="btn btn-danger w-100" disabled>Charge</button>
                            </div>

                            <div class="col">
                                <button type="button"
                                        class="btn btn-secondary w-100"
                                        onclick="openConfirmModal('btnOverdueReturned', 'Mark this overdue rental as Returned and update equipment?')">
                                    Returned
                                </button>
                                <button id="btnOverdueReturned"
                                        type="submit"
                                        value="Returned"
                                        name="actionType"
                                        class="d-none">
                                </button>
                            </div>
                        }

                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- CONFIRMATION MODAL -->
<div id="actionConfirmModal" class="modal-backdrop-custom" style="display:none;">
    <div class="modal-card-custom">
        <div class="modal-header-custom">
            <div class="modal-title-custom">Confirm Action</div>
            <button class="modal-close-btn" onclick="closeConfirmModal()">✕</button>
        </div>

        <div class="modal-body-custom">
            <p id="actionMessage" class="mb-3">Are you sure?</p>
        </div>

        <div class="modal-footer-custom">
            <button class="btn btn-secondary" onclick="closeConfirmModal()">Cancel</button>
            <button class="btn btn-primary" id="actionConfirmBtn">Confirm</button>
        </div>
    </div>
</div>


<script>
    let pendingButtonId = null;

    function openConfirmModal(buttonId, message) {
        pendingButtonId = buttonId;
        document.getElementById('actionMessage').innerText = message;
        document.getElementById('actionConfirmModal').style.display = 'flex';
    }

    function closeConfirmModal() {
        document.getElementById('actionConfirmModal').style.display = 'none';
        pendingButtonId = null;
    }

    document.getElementById('actionConfirmBtn').onclick = function () {
        if (pendingButtonId) {
            document.getElementById(pendingButtonId).click();
        }
        closeConfirmModal();
    };
</script>
